# Shared sign-in password. At least 8 characters. Never commit the real value.
TEAM_PASSWORD=

# Google Sheet that holds the team tabs. The id is the long string in the sheet URL.
TEAM_SHEET_ID=

# Full JSON key for a Google service account that can edit TEAM_SHEET_ID.
# Paste the whole key file, including the curly braces. Same variable command-center uses.
GOOGLE_SERVICE_ACCOUNT_JSON=
